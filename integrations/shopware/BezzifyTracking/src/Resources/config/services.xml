<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Bezzify\Tracking\Service\BezzifyClient">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="cache.object"/>
        </service>

        <service id="Bezzify\Tracking\Subscriber\OrderSubscriber">
            <argument type="service" id="messenger.default_bus"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Bezzify\Tracking\Subscriber\SurveySubscriber">
            <argument type="service" id="Bezzify\Tracking\Service\BezzifyClient"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Bezzify\Tracking\Controller\SurveyController" public="true">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Bezzify\Tracking\Service\BezzifyClient"/>
            <argument type="service" id="messenger.default_bus"/>
        </service>

        <service id="Bezzify\Tracking\MessageHandler\BezzifyRequestHandler">
            <argument type="service" id="Bezzify\Tracking\Service\BezzifyClient"/>
            <argument type="service" id="messenger.default_bus"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="Bezzify\Tracking\Cookie\BezzifyCookieProvider"
                 decorates="Shopware\Storefront\Framework\Cookie\CookieProviderInterface">
            <argument type="service" id="Bezzify\Tracking\Cookie\BezzifyCookieProvider.inner"/>
        </service>
    </services>
</container>
