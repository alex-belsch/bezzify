{
    "name": "bezzify/shopware-tracking",
    "description": "Bezzify tracking and attribution for Shopware 6",
    "type": "shopware-platform-plugin",
    "version": "0.2.0",
    "license": "proprietary",
    "authors": [{ "name": "RLA Digital Solutions" }],
    "require": {
        "shopware/core": "~6.5.0 || ~6.6.0 || ~6.7.0",
        "shopware/storefront": "~6.5.0 || ~6.6.0 || ~6.7.0"
    },
    "autoload": {
        "psr-4": { "Bezzify\\Tracking\\": "src/" }
    },
    "extra": {
        "shopware-plugin-class": "Bezzify\\Tracking\\BezzifyTracking",
        "label": { "de-DE": "Bezzify Tracking", "en-GB": "Bezzify Tracking" },
        "description": {
            "de-DE": "Bindet das Bezzify Tracking ein und meldet Bestellungen serverseitig.",
            "en-GB": "Adds Bezzify tracking and reports orders server side."
        }
    }
}
