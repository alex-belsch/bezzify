# Öffentliche Adresse, unter der Bezzify erreichbar ist (Tracking Skript, Webhooks, Dashboard)
PUBLIC_URL=https://t.deinshop.de

# Mindestens 32 Zeichen, z.B. mit: openssl rand -hex 32
# Schützt Logins und die verschlüsselten Zugangsdaten. Nach dem Start nicht mehr ändern.
APP_SECRET=

# Für docker-compose.yml. Steht unverändert in DATABASE_URL, daher nur Buchstaben und Ziffern, z.B. openssl rand -hex 24
POSTGRES_PASSWORD=

# Ohne DATABASE_URL nutzt Bezzify eine eingebettete Datenbank unter PGLITE_DIR (gut für Tests und kleine Shops)
# DATABASE_URL=postgres://bezzify:passwort@localhost:5432/bezzify
# PGLITE_DIR=./data/pglite

# Anzahl eigener Reverse Proxys vor Bezzify: 1 für Coolify, Traefik oder Caddy, 2 mit Cloudflare davor.
# Gezählt wird von rechts in X-Forwarded-For, weiter links stehende Einträge kann jeder Client fälschen.
TRUST_PROXY=1

# Aufbewahrung und Sessions
# RETENTION_DAYS=400
# MATCH_DATA_RETENTION_DAYS=7
# SESSION_TIMEOUT_MINUTES=30
# LOG_LEVEL=info

# Nur ohne docker-compose.yml, dort sind Port und Hintergrundjobs fest eingestellt
# PORT=8787
# DISABLE_JOBS=1
