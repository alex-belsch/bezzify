{
  "name": "bezzify",
  "version": "0.1.0",
  "private": true,
  "description": "Self hosted marketing attribution for online shops",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "build": "npm run build:tracker && npm run build:dashboard && npm run build:server",
    "build:server": "esbuild src/server.ts src/cli.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external --sourcemap",
    "build:tracker": "esbuild tracker/t.js --minify --target=es2017 --outfile=dist/tracker/t.js",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "demo": "tsx src/cli.ts demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
